{
  "name": "email-delivery",
  "version": "1.1.2",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --signal SIGTERM --delay 300ms --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register' src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'"
  },
  "dependencies": {
    "@spalx/app-life-cycle-pkg": "^1.1.0",
    "@spalx/common-loggers-pkg": "1.0.5",
    "@spalx/email-delivery-pkg": "1.1.6",
    "@spalx/http-transport-adapter": "1.0.11",
    "@spalx/kafka-transport-adapter": "1.1.6",
    "@spalx/service-discovery-pkg": "^1.0.8",
    "@spalx/transport-pkg": "^1.3.1",
    "bullmq": "^5.61.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
